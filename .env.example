# Copy to .env and adjust for your deployment. All service discovery is via
# these keys — application code does not hardcode hosts, ports, or paths.
# No secrets belong in git; .env is gitignored.
# Do NOT put absolute Windows user paths in committed files — only in local .env.

# ===========================================================================
# aranmed backend (ASR + clinical API)
# ===========================================================================
HOST=0.0.0.0
PORT=8010

# ---------------------------------------------------------------------------
# Frontend (Next.js custom server proxies /api → BACKEND_URL)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:8010
# Optional browser override (normally leave unset — use relative /api)
# NEXT_PUBLIC_BACKEND_URL=

# ---------------------------------------------------------------------------
# Ollama (structured EHR build, MCQ/case/exam, report structuring)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5-9b:latest

# ---------------------------------------------------------------------------
# MedicalRAG microservice (knowledge Q&A, education explain, EHR ask, radiology)
# Package: src/medrag — start separately on :8080
#   set PYTHONPATH=src   OR   pip install -e .
#   medrag-serve   OR   python -m medrag.interfaces.api
# ---------------------------------------------------------------------------
MEDRAG_API_URL=http://127.0.0.1:8080
# MEDICALRAG_URL=http://127.0.0.1:8080
# Long RAG asks (retrieve + CPU rerank + vLLM) often need 600–1200s on a single GPU (cold first ask).
# Keep this high on the aranmed backend process so /api/chat and knowledge routes do not abort early.
MEDRAG_TIMEOUT_SEC=1200

# Monorepo root + local data dirs (relative to this repo — prefer these)
MEDRAG_ROOT=.
MEDRAG_DATA_DIR=./data
MEDRAG_QDRANT_STORAGE=./qdrant_storage
# Alias some stacks use:
# QDRANT_PATH=./qdrant_storage
QDRANT_URL=http://127.0.0.1:6333
# MEDRAG_QDRANT_MODE=server
# MEDRAG_CONFIG=./config.yaml
MEDRAG_CATALOG_DB=./catalog.db
# MEDRAG_LIBRARY_DIR=
# MEDRAG_EXAM_DIR=
# MEDRAG_MEHRSYS_DIR=
# MEDRAG_STANDARDS_DIR=
# MEDRAG_PYTHON=

# FastAPI bind for medrag-serve
# MEDRAG_API_HOST=0.0.0.0
# MEDRAG_API_PORT=8080

# --- MedRAG production LLM (vLLM OpenAI-compatible) ---
MEDRAG_LLM_PROVIDER=vllm
MEDRAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
MEDRAG_LLM_MODEL=Qwen/Qwen3.5-4B
MEDRAG_LLM_FALLBACK=ollama
# Qwen3.5 defaults to thinking tokens — keep off for RAG latency (matches config.yaml)
MEDRAG_LLM_ENABLE_THINKING=0
MEDRAG_LLM_STRIP_THINKING=1
# Generation budget for /ask (seconds / tokens)
MEDRAG_LLM_TIMEOUT=900
# MEDRAG_LLM_MAX_TOKENS=768
# MEDRAG_LLM_FALLBACK_MODEL=qwen3.5-9b:latest
# MEDRAG_LLM_FALLBACK_ENDPOINT=http://127.0.0.1:11434
# MEDRAG_OLLAMA_URL=http://127.0.0.1:11434

# --- MedRAG embeddings (bge-m3 via OpenAI-compatible /v1/embeddings) ---
MEDRAG_EMBED_PROVIDER=vllm
MEDRAG_EMBED_BASE_URL=http://127.0.0.1:8001/v1
MEDRAG_EMBED_MODEL=BAAI/bge-m3
# Windows FlagEmbedding shim (scripts/medrag/serve_openai_embed_windows.py):
# prefer CUDA. On RTX 3070 8GB keep VLLM_GPU_MEM_UTIL≈0.50–0.55 so embed fits.
MEDRAG_EMBED_HOST=0.0.0.0
MEDRAG_EMBED_DEVICE=cuda
# Cross-encoder reranker — KEEP cpu on 8GB when LLM+embed(+ASR) share one GPU.
# bge-reranker-v2-m3 needs ~1–1.5GB; concurrent CUDA with vLLM+embed OOMs.
# unload_local_before_generate helps local FlagEmbedding, not a co-resident CE.
MEDRAG_RERANK_DEVICE=cpu
# MEDRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Docker / bare-metal vLLM (see docker-compose.medrag.yml)
# RTX 3070 8GB: leave headroom for embed/ASR — do NOT set 0.85 if embed is CUDA.
VLLM_MODEL=Qwen/Qwen3.5-4B
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=2048
VLLM_GPU_MEM_UTIL=0.55
VLLM_QUANTIZATION=bitsandbytes
VLLM_LANGUAGE_MODEL_ONLY=1
VLLM_EMBED_MODEL=BAAI/bge-m3
VLLM_EMBED_PORT=8001
VLLM_EMBED_GPU_MEM_UTIL=0.25
VLLM_EMBED_MAX_MODEL_LEN=512
# HF_TOKEN=
# HF_HOME=./.cache/huggingface

# ---------------------------------------------------------------------------
# Report templates + hospital/insurance naming rules
# ---------------------------------------------------------------------------
# TEMPLATES_DIR=./backend/data/templates
# TEMPLATES_FETCH_RADREPORT=0
# REPORT_RULES_DIR=./backend/data/report_rules
# REPORT_RULES_DOCX=./backend/data/report_rules/hospital_insurance_report_titles.docx
# REPORT_RULES_TXT=./backend/data/report_rules/hospital_insurance_report_titles.txt
# REPORT_RULES_PDF=./backend/data/report_rules/hospital_insurance_report_titles.pdf
# REPORT_RULES_PATH=./backend/data/REPORT_RULES.json
# REPORT_RULES_MAX_CHARS=6000
# REPORT_RULES_MEDRAG=1

# Clinical safety triage (critical / lethal findings)
# CLINICAL_SAFETY_USE_MEDRAG=1
# CLINICAL_SAFETY_ALWAYS_MEDRAG=0
# CLINICAL_SAFETY_CONFIRM_MEDRAG=0

# ---------------------------------------------------------------------------
# NVIDIA Triton Inference Server (optional additive ASR — default remains hf_asr)
# Prefer host 8002 (container :8000). Port 8001 is MedRAG embed.
# ---------------------------------------------------------------------------
# TRITON_URL=http://127.0.0.1:8002
# TRITON_MODEL=whisper
# TRITON_PROTOCOL=http
# TRITON_TIMEOUT_SEC=300
# WHISPER_MAX_SHORTFORM_S=30
# WHISPER_CHUNK_LENGTH_S=30
# WHISPER_STRIDE_LENGTH_S=0
# WHISPER_TARGET_SR=16000
# WHISPER_OUTPUT_ENGLISH=1
# WHISPER_TASK=translate
# Triton compat / Python Whisper — use CUDA (default was cpu and hammered host CPU)
WHISPER_DEVICE=cuda

# ---------------------------------------------------------------------------
# Hugging Face / Whisper cache (local hf_asr default)
# ---------------------------------------------------------------------------
# HF_HOME=
# Prefer cuda on NVIDIA GPUs (models.yaml: ${ASR_DEVICE:-auto})
ASR_DEVICE=cuda
ASR_DTYPE=float16

# ---------------------------------------------------------------------------
# Optional extra ASR/vision providers (disabled by default in models.yaml)
# ---------------------------------------------------------------------------
# VIBEVOICE_MODEL_PATH=
# CRISPASR_BINARY_PATH=
# CRISPASR_LID_MODEL_PATH=
# VISION_MODEL_PATH=
# VISION_MMPROJ_PATH=

# ---------------------------------------------------------------------------
# Auth / security
# ---------------------------------------------------------------------------
# REQUIRED before running more than one backend replica. Without it each
# worker mints its own random signing secret, so a token issued by one
# replica is rejected by the next (random 401s) and every restart logs
# everyone out. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ASR_AGENT_SECRET=
# ASR_AGENT_TOKEN_TTL=43200        # session token lifetime (seconds)
# Default admin seeded on first start (admin/admin) — change for any
# deployment reachable beyond localhost.
# ASR_AGENT_ADMIN_USER=admin
# ASR_AGENT_ADMIN_PASSWORD=

# Login brute-force throttle (per username+IP, per process).
# LOGIN_MAX_ATTEMPTS=8             # failures within the window before lockout
# LOGIN_WINDOW_SEC=300             # rolling window for counting failures
# LOGIN_LOCKOUT_SEC=900            # lockout duration once tripped

# Browser origins allowed to call the API. "*" suits a single-origin on-prem
# install; set an explicit comma-separated allowlist for anything else.
# CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# Alerts (optional)
# ---------------------------------------------------------------------------
# JWT_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ===========================================================================
# Docker / deployment topology  (docs/core/DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# Every value below has a working default in docker-compose.yml; uncomment to
# override. Nothing is hardcoded in the compose file or the images.
# ---------------------------------------------------------------------------

# --- Knowledge corpus (the real MedicalRAG database) -----------------------
# Absolute path to an existing Qdrant storage directory to mount as the
# vector DB, and the sidecar corpus dir holding catalog.db / chunks / text.
# Windows paths work as-is with Docker Desktop, e.g.:
#   MEDRAG_QDRANT_STORAGE=D:/medical books/MedicalRAG/qdrant_storage
#   MEDRAG_CORPUS_DIR=D:/medical books/MedicalRAG/data
# MEDRAG_QDRANT_STORAGE=./qdrant_storage
# MEDRAG_CORPUS_DIR=./data

# Logical Qdrant stores that actually exist in that corpus (comma-separated).
# Probing collections that were never created wastes time and logs errors.
MEDRAG_QDRANT_STORES=main,standards,expand

# --- Public entrypoint / load balancer -------------------------------------
# GATEWAY_PUBLISH_PORT is what you open in the browser.
GATEWAY_PUBLISH_PORT=8090
# GATEWAY_PORT=8080
# NGINX_VERSION=1.27-alpine

# --- Horizontal scale (gateway load-balances all replicas) -----------------
# docker compose up -d --scale backend=4 --scale medrag=3
# BACKEND_REPLICAS=1
# MEDRAG_REPLICAS=1
# FRONTEND_REPLICAS=1

# --- Load balancer tuning (sized for ~1000 concurrent users) ---------------
# LB_KEEPALIVE=64                 # upstream keepalive connections
# LB_MAX_FAILS=3                  # failures before a replica is ejected
# LB_FAIL_TIMEOUT=15s
# LB_CONNECT_TIMEOUT=10s
# LB_SEND_TIMEOUT=600s            # ASR uploads are long
# LB_READ_TIMEOUT=600s            # LLM generation is long
# LB_HEALTH_TIMEOUT=10s
# LB_MAX_BODY_SIZE=256m           # dictation audio uploads
# LB_NEXT_UPSTREAM_TRIES=3
# LB_AI_RATE=30r/s                # per-IP rate limit on AI endpoints
# LB_AI_BURST=200
# LB_MAX_CONN_PER_IP=100
# LB_RATE_ZONE_SIZE=16m

# --- In-container service discovery ----------------------------------------
# DOCKER_OLLAMA_HOST=http://host.docker.internal:11434
# DOCKER_MEDRAG_API_URL=http://medrag:8080
# DOCKER_QDRANT_URL=http://qdrant:6333
# DOCKER_BACKEND_URL=http://backend:8010
# DOCKER_HF_HOME=/models

# --- Image build args -------------------------------------------------------
# CUDA wheels for the backend (Whisper); CPU wheels for medrag by default.
# TORCH_INDEX=https://download.pytorch.org/whl/cu128
# MEDRAG_TORCH_INDEX=https://download.pytorch.org/whl/cpu

# --- Health / startup budgets ----------------------------------------------
# HEALTHCHECK_INTERVAL=30s
# BACKEND_START_PERIOD=180s       # Whisper model load
# MEDRAG_START_PERIOD=120s
# GPU_COUNT=all
# QDRANT_VERSION=latest
# QDRANT_PUBLISH_PORT=6333
# QDRANT_SEARCH_THREADS=0         # 0 = auto
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
# Qdrant recovery budget. Qdrant does not bind HTTP until all collections are
# loaded; a multi-GB corpus can take many minutes on first start.
# QDRANT_START_PERIOD=900s
# QDRANT_HEALTH_RETRIES=30
# Publish MedicalRAG on the host (debugging / backend outside compose).
# Leave unset in production — the gateway is the entrypoint.
# MEDRAG_PUBLISH_PORT=8081

# --- Health/introspection probe budgets (docs/core/DEPLOYMENT.md §4) --------
# Per-provider health probe cap; registry probes run concurrently.
# PROVIDER_HEALTH_TIMEOUT_SEC=2
# Short connect/read for the optional Triton probe so an absent Triton does
# not slow every /api/models call (its inference timeout is separate).
# TRITON_HEALTH_CONNECT_TIMEOUT_SEC=0.5
# TRITON_HEALTH_READ_TIMEOUT_SEC=2
# /api/health dependency cache.
# HEALTH_CACHE_TTL_SEC=5
# /api/models registry cache. Must exceed the time for the load balancer to
# cycle back to a given worker, or a per-process cache never hits.
# MODELS_CACHE_TTL_SEC=30
# Optional MedicalRAG enhancement calls are bounded separately from
# MEDRAG_TIMEOUT_SEC (which sizes full RAG inference). A cold/slow MedicalRAG
# must never stall report generation or safety enrichment.
# REPORT_RULES_MEDRAG_TIMEOUT_SEC=20
# CLINICAL_SAFETY_MEDRAG_TIMEOUT_SEC=30

# --- Resource limits (docs/core/DEPLOYMENT.md) ------------------------------
# MedicalRAG with local CPU embeddings + reranking loads two ~2.2 GB models.
# Without a cap it can starve the rest of the stack and get OOM-killed
# mid-request. Raise this, or offload embed/rerank to GPU (--profile vllm-embed).
# MEDRAG_MEM_LIMIT=6g
# Backend uvicorn workers inside the container. Each worker loads its own copy
# of the ASR/vision models, so this multiplies VRAM — prefer BACKEND_REPLICAS
# behind the gateway for horizontal scale.
# BACKEND_WORKERS=1
# BACKEND_BACKLOG=2048
# Pre-downloaded model weights (e.g. models/whisper-large-v3/) mounted
# read-only into the backend container so it skips the network download.
# LOCAL_MODELS_DIR=./models

# --- Triton-compatible ASR service (additive; hf_asr stays default) -------
# DOCKER_TRITON_URL=http://triton:8002   # override to point at an external/native Triton
# TRITON_COMPAT_PORT=8002
# TRITON_WHISPER_DEVICE=cpu              # cuda if you have VRAM to spare
# TRITON_WHISPER_WARMUP=0                # 1 = load the model at container start, not first request
# TRITON_START_PERIOD=180s
# DOCKER_WHISPER_MODEL_DIR=/app/models/whisper-large-v3

# ===========================================================================
# Security & durability (added by the hardening pass)
# ---------------------------------------------------------------------------

# --- Auth secret (REQUIRED before scaling past one backend replica) --------
# Each worker otherwise generates its own random signing key, so a token
# minted by one replica is rejected by the next. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ASR_AGENT_SECRET=
# ASR_AGENT_TOKEN_TTL=43200

# --- First-run admin account -----------------------------------------------
# With none of these set, a RANDOM password is generated on first start and
# written to <backend/data>/initial-admin-password.txt (mode 0600). Set a
# password here for an unattended deploy.
# ASR_AGENT_ADMIN_USER=admin
# ASR_AGENT_ADMIN_PASSWORD=
# ADMIN_CREDENTIALS_FILE=
# Opt back in to the old admin/admin default. Local throwaway use only.
# ASR_AGENT_ALLOW_INSECURE_ADMIN=0

# --- Login brute-force throttle --------------------------------------------
# Backend: auto (redis if REDIS_URL set, else sqlite) | memory | sqlite | redis
# 'memory' is per-process, so N replicas give an attacker N x the budget —
# only correct for a single-replica deployment.
# LOGIN_THROTTLE_BACKEND=auto
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_SEC=300
# LOGIN_LOCKOUT_SEC=900
# LOGIN_THROTTLE_MAX_KEYS=10000
# LOGIN_THROTTLE_REDIS_PREFIX=aranmed:login-throttle:
# REDIS_URL=redis://127.0.0.1:6379/0

# --- SQLite concurrency -----------------------------------------------------
# WAL lets readers continue during a write (the default journal blocks them),
# and busy_timeout makes a concurrent writer wait for the lock instead of
# failing with "database is locked". Both matter once backend replicas > 1,
# since they share backend/data/app.db through a bind mount.
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_BUSY_TIMEOUT_MS=5000

# --- TLS at the gateway -----------------------------------------------------
# Enabled by the docker-compose.tls.yml overlay (./deploy.sh --tls), not by
# setting GATEWAY_TLS_ENABLED alone — the overlay also publishes the port.
# GATEWAY_TLS_PUBLISH_PORT=8443
# GATEWAY_TLS_PORT=8443
# GATEWAY_TLS_CERT_DIR=./deploy/nginx/certs
# GATEWAY_TLS_CERT=/etc/nginx/certs/tls.crt
# GATEWAY_TLS_KEY=/etc/nginx/certs/tls.key
# GATEWAY_TLS_PROTOCOLS=TLSv1.2 TLSv1.3
# GATEWAY_TLS_SESSION_CACHE=10m
# GATEWAY_TLS_SESSION_TIMEOUT=1d
# GATEWAY_HSTS_MAX_AGE=31536000

# ---------------------------------------------------------------------------
# Governance: audit trail, RBAC, MFA, password policy
# ---------------------------------------------------------------------------
# Audit trail (backend/audit.py). AUDIT_STRICT=1 refuses the action when the
# trail cannot be written, instead of proceeding and logging the failure.
# AUDIT_STRICT=0
# AUDIT_DETAIL_MAX_CHARS=2000

# RBAC policy is data (backend/data/rbac.json). Point this elsewhere to
# override per deployment. Deny-by-default: unknown roles get nothing.
# RBAC_POLICY_FILE=

# Multi-factor authentication (TOTP, RFC 6238)
# MFA_TOTP_DIGITS=6
# MFA_TOTP_STEP_SEC=30
# MFA_TOTP_WINDOW=1
# MFA_TOTP_ISSUER=AranMed

# Password policy. Length and the weak-password blocklist are always on;
# character-class rules default off (NIST SP 800-63B favours length).
# PASSWORD_MIN_LENGTH=12
# PASSWORD_MAX_LENGTH=1024
# PASSWORD_REQUIRE_UPPER=0
# PASSWORD_REQUIRE_LOWER=0
# PASSWORD_REQUIRE_DIGIT=0
# PASSWORD_REQUIRE_SYMBOL=0
# PASSWORD_BLOCKLIST_FILE=

# ---------------------------------------------------------------------------
# PHI encryption at rest (backend/phi_crypto.py)
# ---------------------------------------------------------------------------
# AES-256-GCM over the patient record. Unset = data stored in the clear and a
# warning logged. Format: keyid:base64key[,keyid2:base64key2] -- the FIRST is
# the active key for new writes, the rest are kept so older rows still decrypt.
# Generate:
#   python -c "import base64,os;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
# PHI_ENCRYPTION_KEYS=
# PHI_ENCRYPTION_KEY_FILE=
# Turning it on needs no migration: existing plaintext rows stay readable and
# are encrypted on next write. To convert everything at once:
#   docker compose exec backend python -c \
#     "import sys;sys.path.insert(0,'/app/backend');import phi_crypto;print(phi_crypto.reencrypt_all())"

# ---------------------------------------------------------------------------
# Internal TLS (gateway -> backend) and terminology bindings
# ---------------------------------------------------------------------------
# Applied by docker-compose.internal-tls.yml; see docs/core/SECURITY.md.
# BACKEND_TLS_ENABLED=0
# BACKEND_TLS_CERT=/etc/aranmed/certs/tls.crt
# BACKEND_TLS_KEY=/etc/aranmed/certs/tls.key
# BACKEND_UPSTREAM_SCHEME=http
# FRONTEND_UPSTREAM_SCHEME=http

# SNOMED/RxNorm bindings for the FHIR export. Unmatched terms stay text-only.
# TERMINOLOGY_FILE=

# ---------------------------------------------------------------------------
# PostgreSQL (optional) — lifts SQLite's single-writer ceiling
# ---------------------------------------------------------------------------
# Unset = SQLite (default). With `docker compose --profile postgres up -d`:
# DATABASE_URL=postgresql://aranmed:aranmed@postgres:5432/aranmed
# POSTGRES_USER=aranmed
# POSTGRES_PASSWORD=aranmed
# POSTGRES_DB=aranmed
# POSTGRES_VERSION=16-alpine
# POSTGRES_PUBLISH_PORT=5432

# ---------------------------------------------------------------------------
# Audit retention, terminology server, MFA recovery
# ---------------------------------------------------------------------------
# Automatic audit trimming. Default ~6 years (HIPAA); 0 disables it when an
# external archiver owns the lifecycle.
# AUDIT_RETENTION_DAYS=2192
# FHIR terminology server, consulted only for terms the local file misses.
# TERMINOLOGY_SERVER_URL=https://tx.fhir.org/r4
# TERMINOLOGY_SERVER_TIMEOUT_SEC=3
# MFA_RECOVERY_CODE_COUNT=10
