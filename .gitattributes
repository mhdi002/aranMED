# Line-ending policy.
#
# Git on Windows checks files out with CRLF by default. That is fine for
# editing, but anything *executed on Linux* must be LF: a shell script with
# CRLF fails with `/usr/bin/env: 'bash\r': No such file or directory`, and a
# Dockerfile ENTRYPOINT or compose healthcheck fails the same way. This was
# caught deploying from a Windows checkout to an Ubuntu server, where every
# .sh file in the bundle was unrunnable.
#
# `eol=lf` forces LF in the working tree regardless of platform or the user's
# core.autocrlf setting, so a Windows checkout produces files a Linux host can
# run — including through `git archive`, which applies these filters.

# Default: let Git decide for text, but never mangle it silently.
* text=auto

# Executed on Linux — must be LF.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
*.template      text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Windows-native — keep CRLF so they run under PowerShell/cmd as expected.
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary — never touch.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.docx          binary
*.rtf           binary
*.m4a           binary
*.wav           binary
*.mp3           binary
*.gguf          binary
*.safetensors   binary
*.bin           binary
*.pt            binary
*.onnx          binary
*.db            binary
*.dcm           binary
